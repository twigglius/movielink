FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Directory.Build.props global.json ./
COPY shared/MovieLink.Core/ shared/MovieLink.Core/
COPY server/src/ server/src/
RUN dotnet publish server/src/MovieLink.Api -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
EXPOSE 5080
ENTRYPOINT ["dotnet", "MovieLink.Api.dll"]
