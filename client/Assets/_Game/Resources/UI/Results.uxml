<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="results" class="screen">
        <ui:Label name="headline" text="Linked!" class="headline" />
        <ui:Label name="score" text="0" class="score" />
        <ui:Label name="summary" text="" class="summary" />
        <ui:Label text="Your chain" class="section-title" />
        <ui:VisualElement name="your-chain" class="chain-list" />
        <ui:Label text="Shortest known chain" class="section-title" />
        <ui:VisualElement name="best-chain" class="chain-list" />
        <ui:VisualElement class="spacer" />
        <ui:Button name="continue-button" text="Continue" class="primary-button" />
    </ui:VisualElement>
</ui:UXML>
