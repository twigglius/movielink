/* Portrait, phone first. The root is a centred column so the browser build looks like the phone build. */
:root {
    --bg: #12141c;
    --panel: #1d2030;
    --text: #f2f3f7;
    --muted: #9aa0b4;
    --accent: #f5b83d;
    --accent-text: #1a1406;
    --bad: #ff6b6b;
    --good: #5ad19a;
}

.app-root {
    flex-grow: 1;
    background-color: var(--bg);
    align-items: center;
}
.app-column {
    flex-grow: 1;
    width: 100%;
    max-width: 720px;
}
.screen {
    flex-grow: 1;
    padding: 32px;
    color: var(--text);
}
Label { color: var(--text); }
.spacer { flex-grow: 1; }

/* Main screen */
.top-bar { flex-direction: row; align-items: center; }
.icon-button {
    width: 88px; height: 88px; font-size: 40px; border-radius: 44px;
    background-color: var(--panel); color: var(--text); border-width: 0;
}
.avatar { -unity-font-style: bold; }
.hero { flex-grow: 1; justify-content: center; align-items: center; }
.game-name { font-size: 112px; -unity-font-style: bold; color: var(--accent); -unity-text-align: middle-center; }
.tagline { font-size: 36px; color: var(--muted); margin-top: 16px; -unity-text-align: middle-center; white-space: normal; }
.bottom { align-items: stretch; }
.primary-button {
    height: 136px; font-size: 52px; -unity-font-style: bold; border-radius: 28px; border-width: 0;
    background-color: var(--accent); color: var(--accent-text); margin: 8px 0;
}
.secondary-button {
    height: 104px; font-size: 40px; border-radius: 24px; border-width: 0;
    background-color: var(--panel); color: var(--text); flex-grow: 1;
}
.link-button { background-color: rgba(0,0,0,0); border-width: 0; color: var(--muted); font-size: 36px; height: 72px; }
.link-button.small { font-size: 28px; height: 56px; }

/* Panels (settings, account, how to play, credits) */
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.6); justify-content: center; padding: 48px; }
.panel { background-color: var(--panel); border-radius: 32px; padding: 40px; }
.panel-title { font-size: 56px; -unity-font-style: bold; margin-bottom: 24px; }
.panel-text { font-size: 32px; color: var(--muted); white-space: normal; margin-bottom: 16px; }
.panel Toggle { font-size: 36px; margin: 12px 0; }
.panel Toggle Label { color: var(--text); font-size: 36px; min-width: 420px; }
.placeholder-note { font-size: 26px; color: var(--accent); margin-top: 12px; white-space: normal; }

/* Match screen */
.match-header { flex-direction: row; justify-content: space-between; align-items: center; }
.timer { font-size: 64px; -unity-font-style: bold; }
.timer.low { color: var(--bad); }
.link-counter { font-size: 36px; color: var(--muted); }
.ends { flex-direction: row; align-items: center; margin: 24px 0; }
.actor-card { flex-grow: 1; flex-basis: 0; background-color: var(--panel); border-radius: 24px; padding: 20px; align-items: center; }
.actor-card.target { border-color: var(--accent); border-width: 3px; }
.initials {
    width: 112px; height: 112px; border-radius: 56px; background-color: #2c3148;
    font-size: 44px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.actor-name { font-size: 34px; -unity-font-style: bold; margin-top: 12px; white-space: normal; -unity-text-align: middle-center; }
.card-caption { font-size: 24px; color: var(--muted); }
.arrow { font-size: 56px; color: var(--muted); margin: 0 12px; }
.chain { flex-grow: 1; flex-shrink: 1; min-height: 160px; }
.chain-node { flex-direction: row; align-items: center; padding: 10px 16px; margin: 4px 0; border-radius: 16px; background-color: var(--panel); }
.chain-node.movie { margin-left: 48px; background-color: #262a3d; }
.chain-node.target-hit { border-color: var(--good); border-width: 3px; }
.chain-node Label { font-size: 32px; }
.chain-node .subtitle { color: var(--muted); font-size: 26px; margin-left: 12px; }
.message { font-size: 30px; color: var(--bad); min-height: 44px; white-space: normal; -unity-text-align: middle-center; }
.search-area { margin-top: 8px; }
.search { font-size: 40px; height: 96px; }
.search > .unity-base-text-field__input { background-color: #ffffff; color: #111111; border-radius: 20px; padding: 0 24px; }
.search-hint { font-size: 26px; color: var(--muted); margin: 6px 8px; }
.results { max-height: 520px; }
.result-row { flex-direction: row; align-items: center; height: 88px; padding: 0 20px; border-bottom-width: 1px; border-color: #2c3148; background-color: rgba(0,0,0,0); border-radius: 0; margin: 0; }
.result-row Label { font-size: 34px; }
.result-row .subtitle { color: var(--muted); font-size: 26px; margin-left: 12px; }
.match-footer { flex-direction: row; align-items: center; margin-top: 12px; }

/* Results */
.headline { font-size: 72px; -unity-font-style: bold; color: var(--accent); -unity-text-align: middle-center; margin-top: 40px; }
.score { font-size: 140px; -unity-font-style: bold; -unity-text-align: middle-center; }
.summary { font-size: 34px; color: var(--muted); -unity-text-align: middle-center; margin-bottom: 24px; white-space: normal; }
.section-title { font-size: 30px; color: var(--muted); margin-top: 20px; margin-bottom: 8px; }
.chain-list { }
.pill-button { height: 88px; padding: 0 32px; font-size: 32px; border-radius: 44px; background-color: var(--panel); color: var(--text); border-width: 0; }
